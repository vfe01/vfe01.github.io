---
import Layout from "../components/Layout/Layout.astro";
import AboutMeCard from "../components/AboutMeCard.astro";
---

<Layout title="@vfe01">
  <div class="
  bg-gray-100
  text-black
  border-2 border-black-950 rounded-lg
  mx-5 sm:mx-auto sm:max-w-4xl
  px-5 sm:px-auto md:px-15">
    <h1 class="maintitle">Welcome!</h1>
    <div class="space-y-2 text-left">
      <p>
        I'm Ville and this is my personal website, which I've linked to in e.g.
        my resume. While it's not very elaborate at this point, I'm working on
        improving it.
      </p>
      <p>
        The hero card below contains personal information, proficiencies, and
        website links in one place.
      </p>
    </div>

    <AboutMeCard />
  </div>
</Layout>
