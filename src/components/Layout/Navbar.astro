---
//inspiration from https://flowbite.com/docs/components/navbar/#default-navbar
const navigation = [
  { label: "Home", href: "/" },
  { label: "Contact", href: "/contact" }
];

const currentPath = Astro.url.pathname;
---

<header class="pt-25 md:pt-29">
  <nav
    aria-label="Main navigation"
    class="bg-stone-950 fixed w-full z-20 top-0 start-0 border border-black text-white md:h-24 md:py-4"
  >
    <div
      class="max-w-screen-xl flex flex-wrap items-center justify-between mx-auto p-4"
    >
      <span
        class="self-center text-xl text-white font-semibold whitespace-nowrap"
      >
        vfe01.xyz
      </span>
      <button
        data-collapse-toggle="navbar-default"
        type="button"
        class="inline-flex items-center p-2 w-10 h-10 justify-center text-sm text-body rounded-base md:hidden hover:bg-neutral-secondary-soft hover:text-heading focus:outline-none focus:ring-2 focus:ring-neutral-tertiary"
        aria-controls="navbar-default"
        aria-expanded="false"
      >
        <span class="sr-only">Open main menu</span>
        <svg
          class="w-6 h-6"
          aria-hidden="true"
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          fill="none"
          viewBox="0 0 24 24"
        >
          <path
            stroke="currentColor"
            stroke-linecap="round"
            stroke-width="2"
            d="M5 7h14M5 12h14M5 17h14"
          >
          </path>
        </svg>
      </button>
      <!-- border-2 border-gray-400-->
      <div
        class="hidden w-full mt-4 rounded-base bg-zinc-800 border-2 border-gray-400 shadow-lg/50 shadow-gray-100
        md:absolute md:left-1/2 md:top-1/2 md:block md:h-12 md:w-1/2 xl:w-1/3 md:-translate-x-1/2 md:-translate-y-1/2 md:mt-0
      "
        id="navbar-default"
      >
        <ul
          class="
            flex h-full flex-col items-stretch overflow-hidden rounded-base
            divide-gray-600 divide-y md:flex-row md:divide-x md:divide-y-0
          "
        >
          {
            navigation.map((item) => (
              <li
                class="flex-1 h-full text-center md:p-0"
              >
                <a
                  href={item.href}
                  aria-current={currentPath === item.href ? "page" : undefined}
                  class={
                    currentPath === item.href
                      ? "flex h-full min-h-12 items-center justify-center px-4 py-3 font-bold text-red-800 bg-gray-400 overflow-hidden md:rounded-none"
                      : "flex h-full min-h-12 items-center justify-center px-4 py-3 font-medium text-white transition-colors hover:bg-neutral-tertiary hover:text-red-800 md:border-0 md:hover:bg-transparent md:hover:text-red-800 md:dark:hover:bg-transparent"
                  }
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </nav>
</header>
