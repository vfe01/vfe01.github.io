---
type AboutMeValue =
    | { type: "text"; text: string }
    | { type: "link"; text: string; href: string; external?: boolean };

type AboutMeItem = {
    label: string;
    value: AboutMeValue;
};

const aboutMePersonalInformation: AboutMeItem[] = [
    { label: "Name", value: { type: "text", text: "Ville Elings" } },
    { label: "Age", value: { type: "text", text: "25" } },
    { label: "Located in", value: { type: "text", text: "Uppsala, Sweden" } },
];

const aboutMeProficiencies: AboutMeItem[] = [
    {
        label: "Education",
        value: {
            type: "text",
            text: "Master's Programme in Computer and Information Engineering (civilingenjor i informationsteknologi)",
        },
    },
    {
        label: "Languages",
        value: { type: "text", text: "C, Java, Python, TypeScript" },
    },
    {
        label: "Focus",
        value: { type: "text", text: "Backend development and security" },
    },
];

const aboutMeWebsiteLinks: AboutMeItem[] = [
    {
        label: "LinkedIn",
        value: {
            type: "link",
            text: "View profile",
            href: "https://www.linkedin.com/in/ville-elings-378a11249/",
            external: true,
        },
    },
    {
        label: "GitHub",
        value: {
            type: "link",
            text: "@vfe01",
            href: "https://github.com/vfe01",
            external: true,
        },
    },
    {
        label: "Source code",
        value: {
            type: "link",
            text: "This website",
            href: "https://github.com/vfe01/vfe01.github.io",
            external: true,
        },
    },
];

const cardSections = [
    {
        title: "Personal Information",
        items: aboutMePersonalInformation,
    },
    {
        title: "Proficiencies",
        items: aboutMeProficiencies,
    },
    {
        title: "Website Links",
        items: aboutMeWebsiteLinks,
    },
];
---

<section aria-label="About me overview" class="w-full my-20">
    <article
        class="relative overflow-hidden rounded-3xl border border-default bg-linear-to-br from-neutral-secondary-soft to-neutral-primary p-6 shadow-lg/90 shadow-neutral-tertiary/90 sm:p-8"
    >
        <div
            class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(255,255,255,0.25),transparent_55%)]"
        >
        </div>
        <div class="relative z-10 space-y-6">
            <div>
                <p
                    class="text-xs font-semibold uppercase tracking-[0.2em] text-body"
                >
                    Hero Card
                </p>
                <h2 class="mt-1 text-3xl font-bold tracking-tight text-heading">
                    About Me
                </h2>
            </div>

            <div
                class="flex flex-col divide-y divide-default rounded-2xl border border-default bg-neutral-primary/70 backdrop-blur-sm lg:flex-row lg:divide-x lg:divide-y-0"
            >
                {
                    cardSections.map((section) => (
                        <section class="p-4 sm:p-5 lg:min-w-0 lg:flex-1">
                            <h3 class="mb-4 text-sm font-semibold uppercase tracking-wide text-heading">
                                {section.title}
                            </h3>

                            <dl class="grid grid-cols-1 gap-2 sm:grid-cols-[minmax(10rem,12rem)_1fr] sm:gap-x-6 sm:gap-y-3">
                                {section.items.map((item) => (
                                    <>
                                        <dt class="text-sm font-medium text-body">
                                            {item.label}
                                        </dt>
                                        <dd class="text-sm text-heading">
                                            {item.value.type === "link" ? (
                                                <a
                                                    class="hyperlink inline-flex items-center gap-1"
                                                    href={item.value.href}
                                                    target={
                                                        item.value.external
                                                            ? "_blank"
                                                            : undefined
                                                    }
                                                    rel={
                                                        item.value.external
                                                            ? "noopener noreferrer"
                                                            : undefined
                                                    }
                                                >
                                                    {item.value.text}
                                                    <span aria-hidden="true">
                                                        ↗
                                                    </span>
                                                </a>
                                            ) : (
                                                item.value.text
                                            )}
                                        </dd>
                                    </>
                                ))}
                            </dl>
                        </section>
                    ))
                }
            </div>
        </div>
    </article>
</section>
